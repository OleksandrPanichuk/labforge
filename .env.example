# subscription = локальний `claude login` (default), api_key = ANTHROPIC_API_KEY
LLM_AUTH_MODE=subscription
# ANTHROPIC_API_KEY=

DATABASE_URL=postgresql://labforge:labforge@localhost:5432/labforge
REDIS_URL=redis://localhost:6379

# lab:worker resolves these relative to its own cwd
LABFORGE_JOBS_DIR=jobs
LABFORGE_CONFIGS_DIR=configs
LABFORGE_AGENTS_DIR=agents

PORT=3000
WEB_BASE_URL=http://localhost:3001
JWT_SECRET=

TG_BOT_TOKEN=
# comma-separated telegram user ids
TG_WHITELIST=
