{
  "name": "labforge",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "ingest": "bun packages/ingest/src/main.ts",
    "images:build": "for f in docker/lab-*.Dockerfile; do n=$(basename $f .Dockerfile); docker build -f $f -t $n . || exit 1; done"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "turbo": "^2.10.10",
    "typescript": "^5.9"
  }
}
